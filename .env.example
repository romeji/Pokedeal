# Database (Docker Compose défaut)
DATABASE_URL="postgresql://pds:pds@localhost:5432/pokemon_deal_scanner?schema=public"

# Gemini Vision (free tier) — https://ai.google.dev
GEMINI_API_KEY=""
# Le nom du modèle "gratuit" recommandé change souvent (plusieurs
# générations Flash sorties/dépréciées en 2026). Va vérifier le modèle
# actuel dans Google AI Studio → Quotas avant de le renseigner ici —
# ne réutilise pas un nom trouvé dans un vieux tutoriel.
GEMINI_MODEL=""

# Discord
DISCORD_WEBHOOK_URL=""

# Telegram Bot API — créer le bot avec @BotFather, puis démarrer une
# conversation avec lui avant de tester l'envoi.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
NOTIFICATION_MAX_ATTEMPTS="3"

# Administration web (imports Cardmarket). Utiliser une longue valeur aléatoire
# et la configurer aussi dans les variables d'environnement Vercel.
ADMIN_TOKEN=""

# Opportunity Engine — frais configurables (section 13). Valeurs de départ
# raisonnables, à ajuster selon ta réalité (barème Vinted, transporteur, etc.)
PLATFORM_FEE_PERCENT="0" # Vinted ne facture pas l'acheteur de commission vendeur
BUYER_PROTECTION_FEE_PERCENT="5" # frais de protection acheteur Vinted (ordre de grandeur — à vérifier toi-même sur ton compte)
SHIPPING_COST_DEFAULT_EUR="5"
RESALE_FEE_PERCENT="5" # frais Cardmarket/Vinted lors de la revente
RISK_MARGIN_PERCENT="10" # marge de sécurité sur la valeur marché (section 13)

# Alertes (section 17) — seuils par défaut, aussi ajustables via AlertRule en base
ALERT_MIN_SCORE="70"
ALERT_MIN_PROFIT_EUR="15"
ALERT_MIN_ROI_PERCENT="25"
ALERT_MIN_CONFIDENCE="0.6"

# Cardmarket — TODO: à renseigner UNIQUEMENT après vérification
# de l'existence et des conditions d'une API officielle (voir section 3 du brief).
CARDMARKET_APP_TOKEN=""
CARDMARKET_APP_SECRET=""

# Vinted — aucune clé officielle : le provider réel reste REVIEW_REQUIRED
# tant que la méthode d'accès n'a pas été vérifiée (voir lib/compliance).
